# ============================================================
# BASE DE DATOS MYSQL
# ============================================================

# Estos datos se obtienen desde el proveedor donde está alojada
# la base de datos.
#
# En Hostinger:
# hPanel > Sitios web > Administrar > Bases de datos > MySQL
#
# En desarrollo local con XAMPP normalmente:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
#
# IMPORTANTE:
# No colocar contraseñas reales en este archivo de ejemplo.

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=


# ============================================================
# AUTH.JS / NEXTAUTH
# ============================================================

# AUTH_SECRET
#
# Se genera localmente desde la terminal con Node.js:
#
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Copiar el resultado únicamente al archivo .env.local real.
# Nunca subir el valor real a GitHub.

AUTH_SECRET=


# URL donde está funcionando el sistema.
#
# Desarrollo local:
# http://localhost:3000
#
# Producción:
# https://capacitacion.uhipocrates.edu.mx

AUTH_URL=http://localhost:3000

AUTH_TRUST_HOST=true


# ============================================================
# GOOGLE OAUTH
# ============================================================

# GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET
#
# Se obtienen desde Google Cloud Console.
#
# Ruta:
# Google Cloud Console
# > Google Auth Platform
# > Clients
# > Crear cliente
# > Aplicación web
#
# También pueden administrarse desde:
# https://console.cloud.google.com/apis/credentials
#
# Deben copiarse únicamente al archivo .env.local real.
# No subir estas credenciales a GitHub.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ============================================================
# DOMINIO PERMITIDO
# ============================================================

# Dominio institucional autorizado para iniciar sesión.
# Este valor no es una contraseña.

DOMINIO_PERMITIDO=uhipocrates.edu.mx


# ============================================================
# CORREO SMTP
# ============================================================

# Configuración del servidor SMTP.
#
# Si se utiliza Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
#
# La cuenta que enviará los correos se coloca en SMTP_USER.
#
# La contraseña NO debe ser la contraseña normal de Gmail.
# Si la cuenta utiliza contraseña de aplicación de Google,
# debe generarse desde la Cuenta de Google.
#
# Ruta:
# Cuenta de Google
# > Seguridad
# > Verificación en dos pasos
# > Contraseñas de aplicaciones
#
# La cuenta debe tener habilitada la verificación en dos pasos.
#
# IMPORTANTE:
# Nunca guardar la contraseña SMTP real en este archivo de ejemplo.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true

SMTP_USER=
SMTP_PASSWORD=


# ============================================================
# REMITENTE DE LOS CORREOS
# ============================================================

# Nombre y correo que aparecerán como remitente.
#
# Ejemplo de formato:
# Portal de Capacitacion <correo@dominio.edu.mx>

MAIL_FROM=


# ============================================================
# CORREO DEL ADMINISTRADOR
# ============================================================

# Correo donde llegarán los avisos administrativos del sistema,
# por ejemplo cuando un usuario haya leído un manual.

ADMIN_EMAIL=